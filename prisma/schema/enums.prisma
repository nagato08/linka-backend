  PHONE_CHANGE
  ACCOUNT_RECOVERY

  @@map("otp_purpose")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@map("device_platform")
}

/// Verdict Play Integrity (Android) / DeviceCheck (iOS).
/// Premier rempart anti-fake : il coupe la création automatisée à la racine.
enum IntegrityVerdict {
  PASS
  FAIL
  UNEVALUATED

  @@map("integrity_verdict")
}

enum ReferralStatus {
  PENDING // filleul inscrit, profil non complété
  QUALIFIED // filleul actif → récompense due
  REWARDED
  REVOKED // fraude détectée sur la branche

  @@map("referral_status")
}

