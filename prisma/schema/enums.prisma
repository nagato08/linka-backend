  @@map("payment_provider_kind")
}

enum MobileMoneyOperator {
  MTN_MOMO
  ORANGE_MONEY

  @@map("mobile_money_operator")
}

/// Machine à états d'un paiement.
/// En mobile money, PENDING et EXPIRED sont des états normaux et fréquents,
/// pas des anomalies : l'utilisateur doit saisir son code PIN hors de l'app.
/// Un job de réconciliation rattrape les transactions restées en suspens.
enum PaymentStatus {
  CREATED
  PENDING // en attente de la saisie du PIN par l'utilisateur
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("payment_status")
}

enum LedgerReason {
  PURCHASE
  SPEND
  REFUND
  REVERSAL
  BONUS_SIGNUP
  BONUS_REFERRAL
  BONUS_PROMO
  ADMIN_ADJUST
  EXPIRY

  @@map("ledger_reason")
}

enum SubscriptionTier {
  FREE
  PLUS
  GOLD

  @@map("subscription_tier")
}

enum SubscriptionStatus {
  ACTIVE
  GRACE // échec de renouvellement, droits maintenus quelques jours
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum EntitlementKey {
  // Droits d'abonnement : illimités tant que la formule court.
  UNLIMITED_REWIND
  NO_ADS
  INCOGNITO
  TRAVEL_MODE
  ADVANCED_FILTERS
  PRIORITY_DECK

  // Droits consommables : achetés à l'unité ou par pack, décomptés à l'usage.
  //
  // EXTRA_REWIND est distinct d'UNLIMITED_REWIND, et ce n'est pas un détail :
  // les confondre reviendrait à offrir un avantage d'abonnement pour le prix
  // d'un pack de dix.
  SUPERLIKE
  EXTRA_REWIND
  MESSAGE_BEFORE_MATCH
  EVENT_CREATION

  @@map("entitlement_key")
}

enum EntitlementSource {
  SUBSCRIPTION
  PURCHASE
  FREE_QUOTA
  ADMIN_GRANT

  @@map("entitlement_source")
}

enum BoostTier {
  BOOST_30M
