// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

// --- Identité & accès -------------------------------------------------------

enum UserStatus {
  PENDING_PHONE // identifiant non encore vérifié
  PENDING_PROFILE // vérifié, profil incomplet
  ACTIVE
  SUSPENDED // sanction temporaire, l'utilisateur en est informé
  SHADOW_BANNED // retiré des decks, l'utilisateur ne le sait pas
  BANNED
  DELETION_PENDING // purge programmée à J+30
  DELETED

  @@map("user_status")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum AppLocale {
  FR
  EN

  @@map("app_locale")
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE

  @@map("auth_provider")
}

/// Canal d'acheminement du code à usage unique.
enum OtpChannel {
